# 默认按文本处理，检出时统一 LF（避免 Windows CRLF 污染仓库）
* text=auto eol=lf

# 明确文本类型
*.ts text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.jsonc text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.example text eol=lf

# 二进制文件不做转换
*.png binary
*.jpg binary
*.ico binary
*.db binary
*.gguf binary
*.onnx binary
*.safetensors binary
